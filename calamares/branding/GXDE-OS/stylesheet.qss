/*
 * SPDX-FileCopyrightText: no
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * Global stylesheet replicating the deepin-installer look:
 * white text and translucent widgets on top of the wallpaper.
 *
 * Icon resources are compiled into the calamares binary under
 * the ":/deepin/" prefix (taken from deepin-installer-reborn,
 * GPL-3.0+).
 */

/*** All text sits on the wallpaper, so it is white. */

QLabel {
  color: #ffffff;
}

/*** Large page title, like deepin's TitleLabel (40px white, centered). */

QLabel#deepinTitle {
  font-size: 40px;
  color: #ffffff;
}

/*** Secondary comment, like deepin's CommentLabel (14px white). */

QLabel#deepinComment {
  font-size: 14px;
  color: #ffffff;
}

/*** Corner buttons in the top-right of the window.
 *
 * The close button uses deepin's close icon; the (optional)
 * about / debug buttons carry a Calamares icon and are plain.
 */

QPushButton#deepinCloseButton {
  border: none;
  outline: none;
  color: #eaeaea;
  margin: 0;
  padding: 0;
  background-clip: border;
  background-origin: padding;
  background-repeat: no-repeat;
  background-position: center center;
  background-image: url(:/deepin/close_normal.svg);
}

QPushButton#deepinCloseButton:hover {
  background-image: url(:/deepin/close_hover.svg);
}

QPushButton#deepinCloseButton:pressed {
  background-image: url(:/deepin/close_press.svg);
}

QPushButton#deepinCornerButton {
  border: none;
  outline: none;
  margin: 0;
  padding: 0;
  background: transparent;
}

/*** Navigation buttons, like deepin's NavButton (310x36, set in code). */

QPushButton#deepinNavButton {
  color: #ffffff;
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  border: none;
  border-radius: 4px;
  outline: none;
  background-color: rgba(255, 255, 255, 0.2);
}

QPushButton#deepinNavButton:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

QPushButton#deepinNavButton:pressed {
  color: #2ca7f8;
  background-color: rgba(255, 255, 255, 0.1);
}

QPushButton#deepinNavButton:disabled {
  color: rgba(255, 255, 255, 0.4);
  background-color: rgba(255, 255, 255, 0.1);
}

/*** Generic page buttons, like deepin's FlatButton. */

QPushButton {
  color: #ffffff;
  text-align: center;
  font-size: 12px;
  border: none;
  border-radius: 4px;
  outline: none;
  background-color: rgba(255, 255, 255, 0.2);
  min-height: 28px;
  padding: 4px 12px;
}

QPushButton:hover {
  background-color: rgba(255, 255, 255, 0.3);
}

QPushButton:pressed {
  color: #2ca7f8;
  background-color: rgba(255, 255, 255, 0.1);
}

QPushButton:disabled {
  color: rgba(255, 255, 255, 0.4);
  background-color: rgba(255, 255, 255, 0.1);
}

/*** Line edits, like deepin's LineEdit. */

QLineEdit {
  border: 1px solid transparent;
  border-radius: 4px;
  padding: 2px 8px;
  background-color: rgba(255, 255, 255, 0.1);
  outline: none;
  color: #dadada;
  selection-background-color: rgba(255, 255, 255, 0.3);
}

QLineEdit:focus {
  border: 1px solid #2ca7f8;
}

/*** Combo boxes. */

QComboBox {
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 4px;
  padding: 2px 8px;
  background-color: rgba(255, 255, 255, 0.1);
  outline: none;
}

QComboBox:hover {
  border: 1px solid rgba(255, 255, 255, 0.4);
}

QComboBox:focus {
  border: 1px solid #2ca7f8;
}

QComboBox::drop-down {
  border: none;
  width: 24px;
}

QComboBox::down-arrow {
  image: url(:/deepin/down_arrow.svg);
}

QComboBox QAbstractItemView {
  color: #ffffff;
  border: none;
  border-radius: 4px;
  background-color: rgba(60, 60, 60, 0.9);
  outline: none;
  selection-background-color: rgba(255, 255, 255, 0.3);
}

/*** Checkboxes, with deepin's checkbox icons. */

QCheckBox {
  color: #ffffff;
  background: transparent;
  spacing: 5px;
}

QCheckBox::indicator {
  width: 16px;
  height: 16px;
}

QCheckBox::indicator:unchecked {
  image: url(:/deepin/checkbox_unchecked.svg);
}

QCheckBox::indicator:unchecked:hover {
  image: url(:/deepin/checkbox_unchecked_hover.svg);
}

QCheckBox::indicator:unchecked:pressed {
  image: url(:/deepin/checkbox_unchecked_pressed.svg);
}

QCheckBox::indicator:checked {
  image: url(:/deepin/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover {
  image: url(:/deepin/checkbox_checked_hover.svg);
}

QCheckBox::indicator:checked:pressed {
  image: url(:/deepin/checkbox_checked_pressed.svg);
}

/*** Item views: transparent with translucent white selection,
 *   like deepin's FramelessListView. */

QListView,
QTreeView,
QTreeWidget {
  color: #ffffff;
  border: none;
  margin: 0px;
  padding: 0px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.1);
  outline: none;
  alternate-background-color: transparent;
}

QListView::item,
QTreeView::item {
  background: transparent;
  min-height: 36px;
  padding: 0px 15px 0px 15px;
  margin: 0px;
  outline: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  selection-background-color: rgba(255, 255, 255, 0.3);
}

QTreeView::branch {
  background: transparent;
}

QListView::item:hover,
QTreeView::item:hover {
  background: rgba(255, 255, 255, 0.16);
}

QListView::item:selected,
QTreeView::item:selected {
  outline: none;
  border: none;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.3);
}

QHeaderView,
QHeaderView::section {
  color: #ffffff;
  background-color: transparent;
  border: none;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  padding: 4px;
}

/*** Scrollbars, thin and translucent like deepin's. */

QScrollBar:vertical {
  width: 8px;
  background: rgba(0, 0, 0, 0%);
  margin: 0px, 0px, 0px, 0px;
  padding-top: 9px;
  padding-bottom: 9px;
}

QScrollBar::handle:vertical {
  width: 8px;
  background: rgba(0, 0, 0, 25%);
  border-radius: 4px;
  min-height: 20;
}

QScrollBar::handle:vertical:hover {
  width: 8px;
  background: rgba(0, 0, 0, 50%);
  border-radius: 4px;
  min-height: 20;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  border: 0px;
  width: 0px;
  height: 0px;
}

QScrollBar:horizontal {
  height: 8px;
  background: rgba(0, 0, 0, 0%);
  margin: 0px, 0px, 0px, 0px;
  padding-left: 9px;
  padding-right: 9px;
}

QScrollBar::handle:horizontal {
  height: 8px;
  background: rgba(0, 0, 0, 25%);
  border-radius: 4px;
  min-width: 20;
}

QScrollBar::handle:horizontal:hover {
  height: 8px;
  background: rgba(0, 0, 0, 50%);
  border-radius: 4px;
  min-width: 20;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  border: 0px;
  height: 0px;
}

/*** Scroll areas (e.g. partition page) must not paint their own background. */

QScrollArea,
QScrollArea > QWidget > QWidget {
  background: transparent;
}

/*** Text views (license texts, release notes). */

QPlainTextEdit,
QTextEdit,
QTextBrowser {
  color: #dadada;
  border: none;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
  selection-background-color: rgba(255, 255, 255, 0.3);
}

/*** Menus and tooltips. */

QMenu {
  color: #ffffff;
  border: none;
  border-radius: 4px;
  background-color: rgba(60, 60, 60, 0.9);
}

QMenu::item {
  padding: 4px 16px;
}

QMenu::item:selected {
  background-color: rgba(255, 255, 255, 0.3);
}

QToolTip {
  color: #ffffff;
  border: none;
  border-radius: 4px;
  background-color: rgba(60, 60, 60, 0.9);
}

/*** Progress bars, translucent white like deepin's. */

QProgressBar {
  color: #ffffff;
  border: none;
  border-radius: 4px;
  background-color: rgba(255, 255, 255, 0.2);
  text-align: center;
}

QProgressBar::chunk {
  border-radius: 4px;
  background-color: #2ca7f8;
}

/*** The confirmation overlay (deepin's ConfirmQuitFrame) re-paints the
 *   wallpaper itself in C++, so it must not paint a background here. */

QWidget#confirmQuitOverlay {
  background: transparent;
}


/*** Installation (slideshow) page: no white frame around the slides,
 *   the wallpaper shows through. */

#execTabWidget {
  background: transparent;
}

#execTabWidget::pane {
  border: none;
  background: transparent;
}

#execTabWidget > QWidget > QWidget {
  background: transparent;
}

/*** Language list on the welcome page, deepin-installer style. */

QListView#languageList {
  font-size: 14pt;
}

/*** User page: the avatar button has no frame of its own, and the
 *   line edits signal ok / error with colored borders (a glow effect
 *   is applied in code). */

QToolButton#userAvatarButton {
  border: none;
  background: transparent;
}

QLineEdit {
  min-height: 30px;
}

QLineEdit[state="ok"] {
  border: 1px solid rgba(76, 175, 80, 0.8);
  background-color: rgba(76, 175, 80, 0.08);
}

QLineEdit[state="error"] {
  border: 1px solid rgba(230, 67, 64, 0.9);
  background-color: rgba(230, 67, 64, 0.08);
}
